{
  "name": "starter-package-ts",
  "version": "2.0.0",
  "description": "starter-package-ts description",
  "author": "Romain Prignon <pro.rprignon@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/romainPrignon/starter-package-ts.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": "20.x",
    "pnpm": "8.x"
  },
  "files": [
    "dist",
    "type",
    "CHANGELOG.md",
    "LICENSE.md",
    "pnpm-lock.yaml",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "postinstall": "gitmoji --init",
    "compile": "rm -rf dist/ && tsc --build",
    "lint": "eslint --ext ts .",
    "fmt": "eslint --fix --ext ts .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:debug": "npm run test --detectOpenHandles --forceExit --runInBand --no-cache",
    "test:watch": "npm run test -- --watch",
    "changelog": "gitmoji-changelog",
    "version": "npm run changelog && git add CHANGELOG.md",
    "version:patch": "npm version --no-commit-hooks patch -m '🔖 Release v%s'",
    "version:minor": "npm version --no-commit-hooks minor -m '🔖 Release v%s'",
    "version:major": "npm version --no-commit-hooks major -m '🔖 Release v%s'",
    "postversion": "git push --follow-tags",
    "prepublishOnly": "pinst --disable && npm run compile",
    "postpublish": "pinst --enable"
  },
  "dependencies": {
    "@romainprignon/utils": "^3.1.3",
    "@sinclair/typebox": "^0.32.13",
    "@sindresorhus/is": "^6.1.0",
    "awilix": "^10.0.1",
    "date-fns": "^3.3.1",
    "debug": "^4.3.4",
    "effector": "^23.2.0",
    "immer": "^10.0.3",
    "ix": "^5.0.0",
    "ramda": "^0.29.1",
    "remeda": "^1.47.0",
    "ts-pattern": "^5.0.6",
    "type-fest": "^4.10.1"
  },
  "devDependencies": {
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/debug": "^4.1.12",
    "@types/node": "^20.11.9",
    "@types/ramda": "^0.29.11",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "@vitest/coverage-v8": "^1.2.2",
    "eslint": "^8.56.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-functional": "^6.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-vitest": "^0.3.20",
    "gitmoji-changelog": "^2.3.0",
    "gitmoji-cli": "^9.0.0",
    "husky": "^9.0.6",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  }
}
